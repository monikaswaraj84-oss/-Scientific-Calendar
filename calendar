   "source": [
    "from tkinter import *\n",
    "from tkinter import messagebox, scrolledtext\n",
    "import calendar\n",
    "\n",
    "class CalendarApp:\n",
    "    def __init__(self, master):\n",
    "        self.master = master\n",
    "        self.master.title(\"CALENDAR\")\n",
    "        self.master.geometry(\"300x200\")\n",
    "        self.master.config(bg=\"white\")\n",
    "\n",
    "        self.current_year = None\n",
    "\n",
    "        # Widgets\n",
    "        self.heading = Label(master, text=\"CALENDAR\", bg=\"dark gray\", font=(\"Times\", 24, 'bold'))\n",
    "        self.year_label = Label(master, text=\"Enter Year:\", bg=\"light green\")\n",
    "        self.year_entry = Entry(master)\n",
    "\n",
    "        self.show_button = Button(master, text=\"Show Calendar\", fg=\"white\", bg=\"green\", command=self.show_calendar)\n",
    "        self.exit_button = Button(master, text=\"Exit\", fg=\"white\", bg=\"red\", command=master.quit)\n",
    "\n",
    "        # Grid Placement\n",
    "        self.heading.grid(row=0, column=0, columnspan=2, pady=10)\n",
    "        self.year_label.grid(row=1, column=0, padx=10, pady=5, sticky=E)\n",
    "        self.year_entry.grid(row=1, column=1, padx=10, pady=5)\n",
    "        self.show_button.grid(row=2, column=0, columnspan=2, pady=10)\n",
    "        self.exit_button.grid(row=3, column=0, columnspan=2)\n",
    "\n",
    "    def show_calendar(self):\n",
    "        try:\n",
    "            year = int(self.year_entry.get())\n",
    "            self.current_year = year\n",
    "            self.open_calendar_window(year)\n",
    "        except ValueError:\n",
    "            messagebox.showerror(\"Invalid Input\", \"Please enter a valid year (e.g., 2025)\")\n",
    "\n",
    "    def open_calendar_window(self, year):\n",
    "        cal_window = Toplevel(self.master)\n",
    "        cal_window.title(f\"Calendar - {year}\")\n",
    "        cal_window.geometry(\"600x650\")\n",
    "        cal_window.config(bg=\"white\")\n",
    "\n",
    "        # Text area with scrollbar\n",
    "        text_area = scrolledtext.ScrolledText(cal_window, wrap=WORD, font=(\"Consolas\", 10), width=70, height=30)\n",
    "        text_area.pack(padx=10, pady=10)\n",
    "\n",
    "        cal_content = calendar.calendar(year)\n",
    "        text_area.insert(INSERT, cal_content)\n",
    "        text_area.config(state='disabled')  # read-only\n",
    "\n",
    "        # Navigation buttons\n",
    "        nav_frame = Frame(cal_window, bg=\"white\")\n",
    "        nav_frame.pack(pady=10)\n",
    "\n",
    "        prev_btn = Button(nav_frame, text=\"<< Previous Year\", bg=\"light blue\", command=lambda: self.update_calendar(text_area, -1))\n",
    "        next_btn = Button(nav_frame, text=\"Next Year >>\", bg=\"light blue\", command=lambda: self.update_calendar(text_area, 1))\n",
    "\n",
    "        prev_btn.grid(row=0, column=0, padx=10)\n",
    "        next_btn.grid(row=0, column=1, padx=10)\n",
    "\n",
    "        self.cal_text_area = text_area  # Save reference to update it later\n",
    "        self.cal_window = cal_window\n",
    "\n",
    "    def update_calendar(self, text_area, offset):\n",
    "        self.current_year += offset\n",
    "        new_content = calendar.calendar(self.current_year)\n",
    "        text_area.config(state='normal')\n",
    "        text_area.delete(1.0, END)\n",
    "        text_area.insert(INSERT, new_content)\n",
    "        text_area.config(state='disabled')\n",
    "        self.cal_window.title(f\"Calendar - {self.current_year}\")\n",
    "\n",
    "# Driver Code\n",
    "if __name__ == \"__main__\":\n",
    "    root = Tk()\n",
    "    app = CalendarApp(root)\n",
    "    root.mainloop() "
   ]
